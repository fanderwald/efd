{
    "apiVersion": 3,
    "name": "acf/topper-split",
    "title": "Topper (Split)",
    "description"  : "This component displays a topper with image on left and text on right.",
    "options":["Mobile Image"],
    "category": "custom-blocks",
    "icon": "images-alt2",
    "keywords": ["custom","topper"],
    "supports": {
        "align": true,
        "jsx": true,
        "color": {
            "text": true,
            "link": false,
            "background": true,
            "gradients": true
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "__experimentalDefaultControls": {
                "padding": true,
                "margin": true
            }
        }
    },
    "attributes": {
        "style": {
          "type": "object",
          "default": {
            "spacing": {
              "padding": {
                "bottom": "var(--wp--preset--spacing--fluid-50-80)"
              }
            }
          }
        }
      },
    "acf": {
        "mode": "preview",
        "renderTemplate": "render.php",
        "blockVersion": 3
    },
    "editorScript": "file:./edit.js",
    "editorStyle": "file:./index.css",
    "style": [ "file:./style-index.css", "wp-mediaelement" ],
    "script": "wp-mediaelement"
}

