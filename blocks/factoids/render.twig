<div class="factoids 
{{fields.factoids_orientation ? 'has-'~fields.factoids_orientation~'-orientation'}}
"  {{attributes ? attributes}}>	
	<ul class="factoids-list">
		{% for factoid in fields.factoids%}
		<li class="factoids-item{{block.textColor ? ' has-'~block['textColor']~'-text-color'}}">
			<p class="factoids-metric"><span>{{factoid.factoids_metric}}</span></p>
			<span class="factoids-description">{{factoid.factoids_description}}</span>
		</li>
		{% endfor %}
	</ul>
</div>