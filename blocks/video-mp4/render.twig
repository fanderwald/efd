<section id="{{fields.section_id}}" class="video-mp4 {{ block.align ? 'align-'~block.align}}">
	<div class="image-group">
		<div class="video">
			<video class="js-player" playsinline data-autoplay-muted="{{ fields.autoplay_muted ? '1' : '0' }}" poster="{{fields.video_feature_image}}">
				<source src="{{fields.mp4_video_url}}" type="video/mp4" />
			</video>
			{% if not fields.autoplay_muted %}
			<button class="js-video-play-btn video-play-btn" type="button" aria-label="Play video">
				<img src="{{theme.link}}/dist/assets/images/video-play-icon.svg" alt="Play Video" height="100" width="100"/>
			</button>
			{% endif %}
			
			{% if fields.autoplay_muted %}
			<button class="js-audio-toggle tdc-video-controls__mute" type="button" aria-label="Toggle Volume">
				{# Muted Icon (Speaker with X) #}
				<svg class="icon-muted" viewBox="0 0 24 24" width="24" height="24">
					<path fill="currentColor" d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"></path>
				</svg>
				
				{# Unmuted Icon (Speaker with Waves) #}
				<svg class="icon-unmuted" viewBox="0 0 24 24" width="24" height="24">
					<path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"></path>
				</svg>
			</button>
			{% endif %}
		</div>	
	</div>
	{% if fields.video_caption %} 
		<div class="video-caption">
			{{fields.video_caption}}
		</div>
	{% endif %}
</section>