{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "name": "acf/registered-block-list",
    "title": "Registered Block List",
    "description": "Automatically displays a list of custom registered blocks with title and description.",
    "category": "custom-blocks",
    "icon": "list-view",
    "keywords": ["documentation", "blocks", "custom", "technical", "specs"],
    "supports": {
        "align": ["wide", "full"],
        "color": {
            "text": true,
            "background": true
        },
        "customClassName": true,
        "spacing": {
            "margin": true,
            "padding": true,
            "__experimentalDefaultControls": {
                "padding": true,
                "margin": true
            }
        }
    },
    "acf": {
        "renderTemplate": "render.php",
        "blockVersion": 3,
        "mode": "preview"
    }
}
