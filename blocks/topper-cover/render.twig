<section class="{{ [
	'topper-cover',
	block.align ? 'align-' ~ block.align,
	fields.hero_image ? 'has-image' : 'no-image',
	fields.hero_video ? 'has-video',
	fields.topper_gallery ? 'has-gallery',
	block.textColor ? 'has-' ~ block.textColor ~ '-color',
	block.backgroundColor ? 'has-' ~ block.backgroundColor ~ '-background-color'
  	]|filter(v => v)|join(' ') }}">
	{% if fields.topper_gallery %}
		<div class="topper-gallery-bg" aria-hidden="true">
			{% for col in 1..3 %}
				<div class="gallery-col gallery-col--{{ col }}">
					<div class="gallery-col__track">
						{% for image in fields.topper_gallery %}
							<div class="gallery-col__item">
								<img src="{{ image.sizes.large ?: image.url }}" alt="" loading="lazy">
							</div>
						{% endfor %}
						{% for image in fields.topper_gallery %}
							<div class="gallery-col__item">
								<img src="{{ image.sizes.large ?: image.url }}" alt="" loading="lazy">
							</div>
						{% endfor %}
					</div>
				</div>
			{% endfor %}
		</div>
	{% endif %}
	<InnerBlocks class="topper-content"/>
</section>