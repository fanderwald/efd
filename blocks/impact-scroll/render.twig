{% set classes = [
    'impact-scroll',
    block.align ? 'align-' ~ block.align,
    block.textColor ? 'has-'~block['textColor']~'-text-color',
    block.backgroundColor ? 'has-'~block['backgroundColor']~'-background-color',
	block.className ? block['className']
    ]|filter(v => v)|join(' ') %}

<div class="{{classes}}" {{attributes}}>
	<div class="impact-scroll-list-scroll">
	<div class="scroll-container">	
	<div class="impact-list">
	{% for story in fields.story_list %}
	{% set story_post = get_post(story) %}
		<div class="impact-card">
			<div class="image-portrait">
				<picture>
					{% set image = get_image(story_post.thumbnail) %}
					<img src="{{image.src}}" alt="{{image.alt}}" width="{{image.width}}" height="{{image.height}}">
					
				</picture>
			</div>
			<div class="impact-title">
				<h3><a href="{{story_post.link}}"><span>{{story_post.title}}</span></a></h3>
			</div>
		</div>
	{% endfor %}
	</div>
	</div>
	</div>
	<div class="scroll-arrows">
        <button class="scroll-arrow--prev arrow-btn prev-btn" aria-label="Previous Card">
            <svg class="arrow-icon">
                <use xlink:href="#swiper-arrow"></use>
            </svg>
        </button>
        <button class="scroll-arrow--next arrow-btn next-btn" aria-label="Next Card">
            <svg class="arrow-icon">
                <use xlink:href="#swiper-arrow"></use>
            </svg>
        </button>
    </div>

</div>