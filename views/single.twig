{% extends "base.twig" %}


{% block content %}



<main class="main-content-wrapper">
	<article class="article-content">
		<header class="article-topper topper-text">
			<div class="acf-innerblocks-container">
				<p class="wp-block-paragraph is-style-micro-heading">Stories of Impact</p>
				<h1 class="wp-block-heading has-primary-color">{{ post.title }}</h1>
				
			</div>
		</header>
		<div class="entry-content">
			<div class="article-body">
				{% if post.thumbnail %}
				<picture class="featured-image">
					{% set image = get_image(post.thumbnail) %}
					{% set sizes = "100vw" %}
					{% include 'template-parts/image-srcset-webp.twig' %}
				</picture>
				{% endif %}
				
				{{post.content}}
			</div>
			<aside class="article-sidebar">
				<div class="sticky-container">
					<div class="sticky-group">
						<div class="article-discretes">
							<p class="wp-block-paragraph">{{ post.date|date("F j, Y") }}</p>
						</div>
						<div class="share-links-group">
						<p class="wp-block-paragraph">Share:</p>
						{% include 'template-parts/share-links.twig' %}
						</div>
					</div>
					{{ sidebar_widgets }}
				</div>
			</aside>
		</div>
		
	</article>
	
</main>

<section class="post-navigation">
	<div class="grid-container">
	<div class="grid-x wayfinding">
		<div class="cell prev-project post-nav-link post-next">
			{% if post.prev.link %}
			<p class="wp-block-paragraph is-style-micro-heading">Next</p>
			 <a class="" href="{{ post.prev.link }}" title="{{ post.prev.title }}"><span>{{ post.prev.title }}</span></a>
			 {% else %}
			 <p class="wp-block-paragraph is-style-micro-heading">Next</p>
			 <a class="" href="{{get_post(3888).link}}">Back to {{get_post(3888).title}}</a>
			 {% endif %}
		</div>
	</div>
	</div>
</section>
{% endblock %}

   