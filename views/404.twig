{% extends "base.twig" %}

{% block content %}


<main class="main-content-wrapper">
	<section class="topper-text">
	<div class="acf-innerblocks-container">

		<div class="story has-default-bleed has-default-width">	
			<div class="acf-innerblocks-container">

			<p class="is-style-micro-heading wp-block-paragraph">Page Not Found</p>
			<h1 class="wp-block-heading has-primary-color has-text-color has-link-color has-fluid-36-65-font-size wp-elements-1" style="margin-top:var(--wp--preset--spacing--0);margin-bottom:var(--wp--preset--spacing--0)">You Broke It!</h1>
			<p class="wp-block-paragraph">Or we did. Anyway, we can't find the page you're looking for.</p>
			<div class="wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex" style="margin-top:var(--wp--preset--spacing--fluid-30-60)">
			<div class="wp-block-button is-style-fill"><a class="wp-block-button__link wp-element-button" href="{{ site.url }}">Go To The Homepage</a></div>
			</div>

			</div>
		</div>


		<div class="story-grid  two-wide-asymmetric-grid" style="padding-top:var(--wp--preset--spacing--max-16);padding-bottom:var(--wp--preset--spacing--max-16);--wp--style--block-gap:45px">	
			<div class="acf-innerblocks-container">

		<div class="story has-default-bleed has-default-width">	
				<div class="acf-innerblocks-container"></div>
		</div>
		</div>
		</div>
</div>
</section>
</main>
{% endblock %}