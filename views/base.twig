{% block html_head_container %}

	{% include 'html-header.twig' %}
	{% block head %}
	{% endblock %}
    {% if global.head_scripts %}
    {{ global.head_scripts }}
    {% endif %}
	</head>

{% endblock %}

<body class="{{ body_class }}">
    {% if global.body_scripts %}
    {{ global.body_scripts }}
    {% endif %}
    
    {{function('wp_body_open')}}
     
    <header id="home" class="site-header">
        <div class="nav-underlay"></div>
        <nav class="site-navigation">
            <div class="top-nav-left column">
                <a class="logo" href="{{site.link}}" rel="home" aria-label="Home">
                    <img src="{{get_image(global.primary_logo).src}}" alt="{{ site.name }}" width="{{get_image(global.primary_logo).width}}" height="{{get_image(global.primary_logo).height}}"/>
                </a>            
            </div>
            <div class="top-nav-right column">
                {% set dropdown = menu %}
                {% include 'template-parts/dropdown-menu.twig' %}
                {% if global.donate_button %}
                    <div class="donate-button">
                        <a href="{{global.donate_button['url']}}"{{global.donate_button['target'] ? ' target="' ~ global.donate_button['target'] ~ '"' : ''}}>{{global.donate_button['title']}}</a>
                    </div>
                {% endif %}
            </div> 
           
            <button aria-label="Menu" class="nav-toggle closed" type="button"><span class="nav-icon"></span></button>
        </nav>
	</header> 
    <div class="mobile-menu">
        <div class="mobile-menu-content">
            <div class="menu-group">
                {% include 'template-parts/accordion-menu.twig' %}
            </div>
        </div>
    </div>
{% block content %}
    Sorry, no content
{% endblock %}



{% block footer %}
	{% include 'footer.twig' %}
	{{ function('wp_footer') }}
{% endblock %}
{% if global.footer_scripts %}
{{ global.footer_scripts }}
{% endif %}

</body>
</html>
