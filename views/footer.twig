<footer class="footer-container">
	<div class="content-group-container">
		<div class="content-group">
			<div class="content-block logo-block">
				<a href="{{site.link}}" rel="home" aria-label="Home">
				<picture>
					{% set image = get_image(global.primary_logo_dark) %}
					{% include 'template-parts/image-srcset.twig' %}
				</picture>
				</a>
			</div>
			<div class="contact-group">
				<div class="address-group">
					<div itemscope itemtype="https://schema.org/PostalAddress">
						<a href="https://www.google.com/maps/search/?api=1&query={{global.contact_info_address | url_encode}}+{{global.contact_info_city | url_encode}}+{{global.contact_info_state | url_encode}}+{{global.contact_info_zip_code | url_encode}}" target="_blank">
						<span itemprop="streetAddress">{{global.contact_info_address}}</span>
						<span itemprop="addressLocality">{{global.contact_info_city}}</span>, 
						<span itemprop="addressRegion">{{global.contact_info_state}}</span> 
						<span itemprop="postalCode">{{global.contact_info_zip_code}}</span>
						</a>
					</div>
					{% if global.contact_info_phone %}
					<div class="phone-group">
					<p>
						<a href="tel:{{global.contact_info_phone}}" itemprop="telephone">
						<span>{{global.contact_info_phone}}</span>
						</a>
					</p>
					</div>
					{% endif %}
					{% include 'template-parts/social-networks.twig' %}
				</div>
				<div class="nav-group">
					<p><span class="copyright">&copy; {{ "now"|date("Y") }} {{ site.name }}.</span> All rights reserved.</p>
					<div class="legal-nav">
						{% for item in legal.items %}
						<a href="{{item.link}}"><span>{{item.title}}</span></a>
						{% endfor %}
					</div>
				</div>
			</div>
		</div>
	</div>	
	
</footer>