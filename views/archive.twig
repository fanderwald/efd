{% extends "base.twig" %}

{% block content %}

<main class="main-content-wrapper">
    <section class="topper-text">
        <div class="acf-innerblocks-container">
            <div class="story has-default-bleed has-default-width has-default-bleed has-default-width">	
                <div class="acf-innerblocks-container">
                    <p class="is-style-micro-heading wp-block-paragraph">Insights &amp; Impact</p>
                    <h1 class="wp-block-heading has-primary-color has-text-color has-link-color has-fluid-36-65-font-size wp-elements-1">{{term.title}}</h1>
                    <p class="wp-block-paragraph">{{term.description}}</p>
                </div>
            </div>
        </div>
    </section>
    <div class="article-filters">
        <div class="search-group">
            <input type="text" id="article-search-input" placeholder="Search" autocomplete="off">
            <button type="button" id="clear-search" class="clear-btn" aria-label="Clear search"><i class="fa-solid fa-xmark close-icon"></i><i class="fa-solid fa-magnifying-glass search-icon"></i></button>
            <ul id="article-results-container" class="dropdown-results"></ul>
        </div>
        <div class="category-group">
            {% include ['template-parts/category-select.twig'] %}
        </div>
    </div>
    <section id="articles" class="article-list">
		{% for post in posts %}
			{% include ['template-parts/content-card.twig'] %}
		{% endfor %}
	</section>
    {% if posts.pagination %}
    <div class="wayfinding">
        {{ function('foundationpress_pagination') }}
    </div>
    {% endif %}
    {{ function('do_blocks', '<!-- wp:block {"ref":82668} /-->') }}
</main>
{#% include 'partial/pagination.twig' with { pagination: posts.pagination({show_all: false, mid_size: 3, end_size: 2}) } %#}
{% endblock %}