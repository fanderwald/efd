<div class="category-select">
  <select id="category-select-js">
    <option value="{{ site.url }}/articles/" {{ current_cat is not defined or current_cat.taxonomy != 'category' ? 'selected' }}>
      Explore Topics
    </option>
    {% set current_cat = fn('get_queried_object') %}
    {% for category in categories %}
      <option value="{{ category.link }}" {{ current_cat.term_id == category.term_id ? 'selected' }}>
        {{ category.name }}
      </option>
    {% endfor %}
  </select>
</div>