<ul class="nav-items" data-magellan>
    {% for item in menu.items %}
    <li class="menu-item-{{loop.index}}">
        <a href="{{item.link}}">{{item.title}}</a>
        {% if item.children %}
        <ul class="nav-drop">
            {% for child in item.children %}
                <li class="nav-drop-item">
                    <a href="{{child.link}}">{{ child.title }}</a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    </li>
    {% endfor %}
</ul>